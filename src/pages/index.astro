---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Timeline from '../components/Timeline.astro';
import BlogGrid from '../components/BlogGrid.astro';
import TestimonialsCarousel from '../components/TestimonialsCarousel.astro';
import ContactSection from '../components/ContactSection.astro';
import PulseRibbon from '../components/PulseRibbon.astro';

const t = (await import('../lib/i18n.ts')).useTranslations('es');
---

<BaseLayout title={t['hero.title']} lang="es" description="Portfolio médico profesional - Servicios, trayectoria y blog médico">
  <HeroSection lang="es" />
  
  <PulseRibbon />

  <ServicesGrid 
    lang="es"
    title={t['services.title']}
    viewAllText={t['services.viewAll']}
    viewAllHref="/servicios"
  />

  <PulseRibbon />

  <Timeline lang="es" title={t['timeline.title']} />

  <PulseRibbon />

  <BlogGrid lang="es" />

  <PulseRibbon />

  <TestimonialsCarousel lang="es" />

  <PulseRibbon />

  <ContactSection lang="es" />
</BaseLayout>
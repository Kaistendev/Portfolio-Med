---
import BaseLayout from '../layouts/BaseLayout.astro';
const t = (await import('../lib/i18n.ts')).useTranslations('es');
---
<BaseLayout title={t['hero.title']} lang="es">
  <main>
    <h1>{t['hero.title']}</h1>
    <p>{t['hero.specialty']}</p>
    <p>{t['hero.license']}</p>
  </main>
</BaseLayout>
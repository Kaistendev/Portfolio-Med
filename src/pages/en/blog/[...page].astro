---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import Button from '../../../components/Button.astro';
import PulseRibbon from '../../../components/PulseRibbon.astro';

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection('blog_en');
  return paginate(posts, { pageSize: 1, url: (page) => page === 1 ? '/en/blog/' : `/en/blog/page/${page}/` });
}

const { page, lang } = Astro.props;
const t = (await import('../../../lib/i18n.ts')).useTranslations(lang);

const posts = page.data;
const post = posts[0];

if (!post) {
  return Astro.redirect('/en/blog/');
}

const { title, date, author, category, image, body } = post.data;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const shareUrl = `${import.meta.env.SITE}${Astro.url.pathname}`;
const shareTitle = encodeURIComponent(title);
const shareText = encodeURIComponent(`Read: ${title}`);

const allPosts = await getCollection('blog_en');
const currentIndex = allPosts.findIndex(p => p.slug === post.slug);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
---

<BaseLayout title={title} lang={lang} description={body?.slice(0, 160)}>
  <Section id="articulo" className="bg-surface" padding="xl">
    <article class="max-w-4xl mx-auto">
      <header class="mb-8 text-center">
        <div class="flex items-center justify-center gap-2 mb-4">
          <span class="inline-flex items-center justify-center px-3 py-1 text-sm font-medium rounded-full bg-primary/10 text-primary border border-primary/20">
            {category}
          </span>
          <time class="text-sm text-surface/60 font-mono" datetime={date}>
            {formattedDate}
          </time>
        </div>
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-medium text-surface mb-4">{title}</h1>
        <p class="text-surface/70 text-lg max-w-2xl mx-auto">
          {t['blog.readMore'].replace('Leer más', '').replace('Read more', '') || 'By '} <span class="font-medium text-primary">{author}</span>
        </p>
      </header>

      {image && (
        <figure class="mb-10 rounded-2xl overflow-hidden">
          <img src={image} alt="" class="w-full h-auto" loading="lazy" />
        </figure>
      )}

      <div class="prose prose-primary max-w-none" set:html={body} />

      <footer class="mt-12 pt-8 border-t border-primary/10">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
          <div class="flex items-center gap-2">
            <span class="text-sm text-surface/60 font-mono">Share:</span>
            <a href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noopener noreferrer" class="text-surface/60 hover:text-accent transition-colors" aria-label="Twitter">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener noreferrer" class="text-surface/60 hover:text-accent transition-colors" aria-label="LinkedIn">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href={`mailto:?subject=${shareTitle}&body=${shareText}%20${shareUrl}`} class="text-surface/60 hover:text-accent transition-colors" aria-label="Email">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </a>
          </div>
        </div>

        <nav class="grid sm:grid-cols-2 gap-4" aria-label="Post navigation">
          {prevPost && (
            <a href={`/en/blog/${prevPost.slug}/`} class="flex items-center gap-3 p-4 bg-primary/5 border border-primary/10 rounded-xl hover:bg-primary/10 transition-colors">
              <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              <div>
                <p class="text-xs text-surface/60 font-mono uppercase">Previous post</p>
                <p class="font-medium text-surface line-clamp-1">{prevPost.data.title}</p>
              </div>
            </a>
          )}
          {nextPost && (
            <a href={`/en/blog/${nextPost.slug}/`} class="flex items-center gap-3 p-4 bg-primary/5 border border-primary/10 rounded-xl hover:bg-primary/10 transition-colors sm:justify-end sm:ml-auto">
              <div class="text-right">
                <p class="text-xs text-surface/60 font-mono uppercase">Next post</p>
                <p class="font-medium text-surface line-clamp-1">{nextPost.data.title}</p>
              </div>
              <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          )}
        </nav>
      </footer>
    </article>
  </Section>

  <PulseRibbon />
</BaseLayout>
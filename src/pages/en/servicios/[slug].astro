---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import Button from '../../../components/Button.astro';
import PulseRibbon from '../../../components/PulseRibbon.astro';

export async function getStaticPaths() {
  const services = await getCollection('servicios_en');
  return services.map(service => ({
    params: { slug: service.id },
    props: { service, lang: 'en' as const },
  }));
}

const { service, lang } = Astro.props;
const t = (await import('../../../lib/i18n.ts')).useTranslations(lang);
const { title, description, body, icon } = service.data;

const icons: Record<string, string> = {
  stethoscope: '<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17V7a4 4 0 018 0v10M3 21h18M9 21a4 4 0 000-8h2a4 4 0 000 8H9z"/></svg>',
  heart: '<svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>',
  checkup: '<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>',
  chronic: '<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>',
  prevention: '<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>',
  consultation: '<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>',
};
---

<BaseLayout 
  title={title} 
  lang={lang} 
  description={description}
  canonicalURL={`/en/servicios/${service.id}/`}
  schemaType="Service"
  schemaData={{
    name: title,
    description: description,
    medicalSpecialty: 'Internal Medicine',
    url: `https://portfolio-med.netlify.app/en/servicios/${service.id}/`,
  }}
>
  <Section id="servicio" className="bg-surface" padding="xl">
    <div class="max-w-4xl mx-auto text-center mb-16">
      <div class="inline-flex items-center justify-center w-24 h-24 rounded-2xl bg-primary/10 text-primary mb-6">
        {icons[icon] || icons.stethoscope}
      </div>
      <h1 class="font-display text-4xl md:text-5xl font-medium text-surface mb-4">{title}</h1>
      <p class="text-lg text-surface/70 max-w-2xl mx-auto">{description}</p>
    </div>

    <div class="prose prose-primary max-w-4xl mx-auto">
      <div set:html={body} />
    </div>

    <div class="text-center mt-12 pt-8 border-t border-primary/10">
      <Button variant="primary" size="lg" href="#contacto">
        {t['hero.cta']}
      </Button>
      <Button variant="outline" size="lg" href="/en/servicios" className="ml-4">
        {t['services.viewAll']}
      </Button>
    </div>
  </Section>

  <PulseRibbon />
</BaseLayout>
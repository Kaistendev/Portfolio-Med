---
interface Props {
  title: string;
  description?: string;
  lang: 'es' | 'en';
  canonicalURL?: string;
}
const { title, description = 'Portfolio médico profesional - Servicios, trayectoria y blog médico', lang, canonicalURL } = Astro.props;
const t = (await import('../lib/i18n.ts')).useTranslations(lang);
const siteURL = import.meta.env.SITE || 'https://portfolio-med.example.com';
const url = canonicalURL ? `${siteURL}${canonicalURL}` : siteURL;
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="es" href={`${siteURL}/`} />
    <link rel="alternate" hreflang="en" href={`${siteURL}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteURL}/`} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'MedicalBusiness',
      name: 'Dr. Juan Pérez - Medicina Interna',
      url: siteURL,
      logo: `${siteURL}/logo.png`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Calle Médica 123',
        addressLocality: 'Ciudad',
        addressRegion: 'Estado',
        postalCode: '12345',
        addressCountry: 'ES'
      },
      telephone: '+34-900-123-456',
      email: 'contacto@portfolio-med.example.com',
      medicalSpecialty: 'Internal Medicine',
      priceRange: '€€'
    })} />
  </head>
  <body class="font-body antialiased text-text bg-bg">
    <Navbar lang={lang} />
    <main id="main-content" class="pt-16">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppButton lang={lang} />
    <script is:inline>
      document.documentElement.lang = '{lang}';
    </script>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,slnt,SOFT,wght@0,9..144,0..1,0..1,0..1,100..900;1,9..144,0..1,0..1,0..1,100..900&family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --color-primary: #0D7377;
    --color-accent: #D4A853;
    --color-bg: #F7F8FA;
    --color-text: #1A202C;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  body {
    font-family: 'Outfit', system-ui, sans-serif;
    color: var(--color-text);
    background-color: var(--color-bg);
    line-height: 1.6;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Fraunces', serif;
    font-variation-settings: 'SOFT' 100;
    line-height: 1.2;
  }

  .font-mono {
    font-family: 'JetBrains Mono', monospace;
  }

  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
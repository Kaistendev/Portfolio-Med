---
interface Props {
  lang: 'es' | 'en';
  phone?: string;
  message?: string;
}
const { lang, phone = '+34900123456', message } = Astro.props;

const defaultMessage = lang === 'es'
  ? 'Hola Dr. Juan Pérez, me gustaría agendar una cita.'
  : 'Hello Dr. Juan Pérez, I would like to book an appointment.';

const encodedMessage = encodeURIComponent(message || defaultMessage);
const whatsappUrl = `https://wa.me/${phone.replace(/\D/g, '')}?text=${encodedMessage}`;
---
<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 rounded-full bg-green-500 hover:bg-green-600 text-white shadow-lg transition-all duration-300 hover:scale-105 focus:outline-none focus:ring-4 focus:ring-green-500/30 animate-pulse-subtle"
  aria-label={lang === 'es' ? 'Contactar por WhatsApp' : 'Contact via WhatsApp'}
  title={lang === 'es' ? 'Contactar por WhatsApp' : 'Contact via WhatsApp'}
>

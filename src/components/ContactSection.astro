---
import Section from './Section.astro';

interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;
const t = (await import('../lib/i18n.ts')).useTranslations(lang);

const contactInfo = {
  address: lang === 'es' ? 'Calle Médica 123, 28001 Madrid, España' : 'Medical Street 123, 28001 Madrid, Spain',
  phone: '+34 900 123 456',
  email: 'contacto@drjuanperez.es',
  hours: lang === 'es' 
    ? 'Lun-Vie: 9:00-14:00 / 16:00-20:00' 
    : 'Mon-Fri: 9:00-14:00 / 16:00-20:00',
};
---

<Section id="contacto" className="bg-bg" padding="xl">
  <div slot="header" class="text-center">
    <h2 class="font-display text-3xl md:text-4xl font-medium text-surface">{t['contact.title']}</h2>
  </div>

  <div class="max-w-6xl mx-auto px-4">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
      <div>
        <h3 class="font-display text-2xl font-medium text-surface mb-6">{lang === 'es' ? 'Información de Contacto' : 'Contact Information'}</h3>
        
        <div class="space-y-6 mb-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/>
              </svg>
            </div>
            <div>
              <h4 class="font-medium text-surface mb-1">{t['contact.address']}</h4>
              <p class="text-surface/70">{contactInfo.address}</p>
            </div>
          </div>
          
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <h4 class="font-medium text-surface mb-1">{t['contact.phone']}</h4>
              <a href={`tel:${contactInfo.phone}`} class="text-surface/70 hover:text-accent transition-colors">{contactInfo.phone}</a>
            </div>
          </div>
          
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary flex-shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <h4 class="font-medium text-surface mb-1">{t['contact.email']}</h4>
              <a href={`mailto:${contactInfo.email}`} class="text-surface/70 hover:text-accent transition-colors">{contactInfo.email}</a>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary flex-shrink-0 mt-1">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <h4 class="font-medium text-surface mb-1">{t['contact.hours']}</h4>
              <p class="text-surface/70">{contactInfo.hours}</p>
            </div>
          </div>
        </div>

        <div class="bg-surface rounded-2xl p-6 border border-primary/10">
          <h3 class="font-display text-xl font-medium text-surface mb-4">{lang === 'es' ? 'Mapa' : 'Map'}</h3>
          <div id="map" class="w-full h-80 rounded-xl overflow-hidden"></div>
        </div>
      </div>

      <div>
        <h3 class="font-display text-2xl font-medium text-surface mb-6">{lang === 'es' ? 'Enviar Mensaje' : 'Send Message'}</h3>
        
        <form id="contact-form" class="space-y-5" novalidate>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-medium text-surface mb-2">{t['contact.form.name']} <span class="text-accent" aria-hidden="true">*</span></label>
              <input type="text" id="name" name="name" required autocomplete="name" class="w-full px-4 py-3 text-surface bg-bg border border-primary/20 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all" placeholder={lang === 'es' ? 'Juan Pérez' : 'Juan Pérez'}>
              <p class="mt-1 text-sm text-red-500 hidden" aria-live="polite"></p>
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-surface mb-2">{t['contact.form.email']} <span class="text-accent" aria-hidden="true">*</span></label>
              <input type="email" id="email" name="email" required autocomplete="email" class="w-full px-4 py-3 text-surface bg-bg border border-primary/20 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all" placeholder="juan@ejemplo.com">
              <p class="mt-1 text-sm text-red-500 hidden" aria-live="polite"></p>
            </div>
          </div>
          
          <div>
            <label for="message" class="block text-sm font-medium text-surface mb-2">{t['contact.form.message']} <span class="text-accent" aria-hidden="true">*</span></label>
            <textarea id="message" name="message" required rows="5" class="w-full px-4 py-3 text-surface bg-bg border border-primary/20 rounded-lg focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all resize-y" placeholder={lang === 'es' ? 'Escriba su mensaje aquí...' : 'Write your message here...'}></textarea>
            <p class="mt-1 text-sm text-red-500 hidden" aria-live="polite"></p>
          </div>

          <div class="flex items-start gap-3">
            <input type="checkbox" id="privacy" name="privacy" required class="mt-1 w-4 h-4 text-accent border-primary/30 rounded focus:ring-accent focus:ring-2">
            <label for="privacy" class="text-sm text-surface/70 cursor-pointer">
              {lang === 'es' 
                ? 'Acepto la <a href="/privacidad" class="text-accent hover:underline">Política de Privacidad</a> y consiento el tratamiento de mis datos.'
                : 'I accept the <a href="/en/privacy" class="text-accent hover:underline">Privacy Policy</a> and consent to data processing.'}
            </label>
          </div>

          <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3 text-lg font-medium text-primary bg-accent hover:bg-accent/90 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-primary">
            <span>{t['contact.form.submit']}</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          </button>
          
          <p id="form-status" class="hidden text-sm" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</Section>

<script>
  // Leaflet map initialization
  const mapContainer = document.getElementById('map');
  if (mapContainer && typeof L !== 'undefined') {
    const map = L.map('map').setView([40.4168, -3.7038], 15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);
    L.marker([40.4168, -3.7038]).addTo(map)
      .bindPopup('Dr. Juan Pérez<br>Calle Médica 123, 28001 Madrid')
      .openPopup();
  } else if (mapContainer) {
    // Fallback: load Leaflet dynamically
    const script = document.createElement('script');
    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    script.onload = () => {
      const style = document.createElement('link');
      style.rel = 'stylesheet';
      style.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(style);
      
      const map = L.map('map').setView([40.4168, -3.7038], 15);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
      }).addTo(map);
      L.marker([40.4168, -3.7038]).addTo(map)
        .bindPopup('Dr. Juan Pérez<br>Calle Médica 123, 28001 Madrid')
        .openPopup();
    };
    document.body.appendChild(script);
  }

  // Form validation and submission
  const form = document.getElementById('contact-form');
  const statusEl = document.getElementById('form-status');
  const lang = document.documentElement.lang || 'es';

  function showError(input, message) {
    const errorEl = input.parentElement.querySelector('p[aria-live]');
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
    input.classList.add('border-red-500');
    input.classList.remove('border-primary/20');
  }

  function clearError(input) {
    const errorEl = input.parentElement.querySelector('p[aria-live]');
    if (errorEl) {
      errorEl.classList.add('hidden');
    }
    input.classList.remove('border-red-500');
    input.classList.add('border-primary/20');
  }

  function validateEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  form.querySelectorAll('input, textarea').forEach(input => {
    input.addEventListener('input', () => clearError(input));
    input.addEventListener('blur', () => {
      if (input.required && !input.value.trim()) {
        showError(input, lang === 'es' ? 'Este campo es obligatorio' : 'This field is required');
      } else if (input.type === 'email' && input.value && !validateEmail(input.value)) {
        showError(input, lang === 'es' ? 'Email inválido' : 'Invalid email');
      }
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    let isValid = true;
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    if (!data.name.trim()) { showError(form.name, lang === 'es' ? 'Nombre requerido' : 'Name required'); isValid = false; }
    if (!data.email.trim()) { showError(form.email, lang === 'es' ? 'Email requerido' : 'Email required'); isValid = false; }
    else if (!validateEmail(data.email)) { showError(form.email, lang === 'es' ? 'Email inválido' : 'Invalid email'); isValid = false; }
    if (!data.message.trim()) { showError(form.message, lang === 'es' ? 'Mensaje requerido' : 'Message required'); isValid = false; }
    if (!form.privacy.checked) { isValid = false; }
    
    if (!isValid) return;

    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.innerHTML = lang === 'es' ? 'Enviando...' : 'Sending...';

    try {
      // Replace with your Formspree/Resend endpoint
      const response = await fetch('https://formspree.io/f/your-form-id', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (response.ok) {
        statusEl.textContent = lang === 'es' ? 'Mensaje enviado correctamente. Le responderemos pronto.' : 'Message sent successfully. We will reply soon.';
        statusEl.className = 'text-green-600';
        form.reset();
      } else {
        throw new Error('Form submission failed');
      }
    } catch (err) {
      statusEl.textContent = lang === 'es' ? 'Error al enviar. Intente de nuevo o contáctenos por teléfono.' : 'Error sending. Please try again or contact us by phone.';
      statusEl.className = 'text-red-600';
    }
    
    statusEl.classList.remove('hidden');
    submitBtn.disabled = false;
    submitBtn.innerHTML = originalText;
  });
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    #map { animation: none !important; }
  }
</style>
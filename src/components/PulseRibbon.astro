---
interface Props {
  class?: string;
  color?: string;
  speed?: number;
  height?: number;
}
const { class: className = '', color = '#0D7377', speed = 2, height = 4 } = Astro.props;
const uniqueId = `pulse-${Math.random().toString(36).substr(2, 9)}`;
const pathLength = 1000;
---

<div class={`w-full overflow-hidden ${className}`} style={{ height: `${height}px` }} role="img" aria-label="Línea decorativa de latido cardíaco">
  <svg 
    viewBox="0 0 1000 100" 
    preserveAspectRatio="none" 
    class="w-full h-full"
    style={{ display: 'block' }}
  >
    <defs>
      <linearGradient id={`${uniqueId}-gradient`} x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color={color} stop-opacity="0.3" />
        <stop offset="50%" stop-color={color} stop-opacity="1" />
        <stop offset="100%" stop-color={color} stop-opacity="0.3" />
      </linearGradient>
    </defs>
    
    <path
      id={`${uniqueId}-path`}
      d="M0,50 
         C100,50 150,50 200,50
         C220,50 230,30 240,30
         C250,30 260,70 270,70
         C280,70 290,30 300,30
         C310,30 320,50 340,50
         C440,50 540,50 640,50
         C660,50 670,30 680,30
         C690,30 700,70 710,70
         C720,70 730,30 740,30
         C750,30 760,50 780,50
         C880,50 980,50 1000,50"
      stroke={`url(#${uniqueId}-gradient)`}
      stroke-width={height}
      stroke-linecap="round"
      fill="none"
      style={{
        strokeDasharray: pathLength,
        strokeDashoffset: 0,
      }}
    />
    
    <animate
      attributeName="strokeDashoffset"
      from="0"
      to={-pathLength}
      dur={`${speed}s`}
      repeatCount="indefinite"
    />
  </svg>

  <style>
    @media (prefers-reduced-motion: reduce) {
      ##{uniqueId}-path {
        animation: none !important;
        stroke-dashoffset: 0 !important;
      }
    }
  </style>
</div>
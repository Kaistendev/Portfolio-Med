---
interface Props {
  id?: string;
  class?: string;
  title?: string;
  subtitle?: string;
  align?: 'left' | 'center' | 'right';
  padding?: 'sm' | 'md' | 'lg' | 'xl';
  background?: 'none' | 'primary' | 'bg' | 'muted';
}
const { 
  id, 
  class: className = '', 
  title, 
  subtitle, 
  align = 'center', 
  padding = 'xl', 
  background = 'none' 
} = Astro.props;
const hasTitle = !!title;
const hasSubtitle = !!subtitle;

const paddingStyles = {
  sm: 'py-8 sm:py-12',
  md: 'py-12 sm:py-16',
  lg: 'py-16 sm:py-20 lg:py-24',
  xl: 'py-20 sm:py-24 lg:py-32',
};

const backgroundStyles = {
  none: '',
  primary: 'bg-primary',
  bg: 'bg-bg',
  muted: 'bg-primary/5',
};

const alignStyles = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
};

const sectionClasses = [
  'w-full',
  paddingStyles[padding],
  backgroundStyles[background],
  alignStyles[align],
  className,
].filter(Boolean).join(' ');

const containerClasses = 'mx-auto max-w-7xl px-4 sm:px-6 lg:px-8';
---

<section id={id} class={sectionClasses} aria-labelledby={id ? `${id}-title` : undefined}>
  <div class={containerClasses}>
    {(hasTitle || hasSubtitle) && (
      <header class="mb-10 lg:mb-12">
        {hasSubtitle && (
          <p class="font-mono text-xs font-medium text-accent uppercase tracking-wider mb-2">
            {subtitle}
          </p>
        )}
        {hasTitle && (
          <h2 id={id ? `${id}-title` : undefined} class="font-display text-3xl sm:text-4xl lg:text-5xl font-medium text-surface">
            {title}
          </h2>
        )}
      </header>
    )}
    <slot />
  </div>
</section>